# GoreeCloud Drive development configuration.
# Copy to .env only for local use; never commit real secrets.

GC_DRIVE_BIND=127.0.0.1:8080
GC_DRIVE_DATA_DIR=./data
GC_DRIVE_WEB_DIR=./web
GC_DRIVE_ALLOW_PUBLIC_BIND=false
GC_DRIVE_SHUTDOWN_TIMEOUT=10s

# Resumable upload runtime wiring is disabled by default. When enabled, upload
# completion fails closed through the signed, loopback-only Wardveil Scan gate.
# The current runtime still uses the development in-memory upload-session
# repository; PostgreSQL runtime wiring and production storage acceptance remain
# separate milestones.
GC_DRIVE_UPLOADS_ENABLED=false
GC_DRIVE_UPLOAD_MAX_CHUNK_BYTES=8388608
GC_DRIVE_UPLOAD_SESSION_TTL=24h
GC_DRIVE_WARDVEIL_SCAN_ENDPOINT=http://127.0.0.1:8791/v1/scan
GC_DRIVE_WARDVEIL_SCAN_CALLER_ID=goreecloud-drive
GC_DRIVE_WARDVEIL_SCAN_KEY_ID=scan-current

# Path only. The credential itself must live in an owner-only regular file and
# must never be committed or placed directly in this environment file.
GC_DRIVE_WARDVEIL_SCAN_SECRET_FILE=

# Optional in development. When empty, the internal Wardveil quarantine target
# fails closed with service authorization unavailable. Supply only through the
# deployment secret store; never commit the production value.
GC_DRIVE_WARDVEIL_SERVICE_TOKEN=
